{
  "terraform": {
    "backend": {
      "kubernetes": {}
    }
  },
  "variable": {
    "bootstrap_data": {
      "type": "string",
      "sensitive": true
    },
    "bootstrap_format": {
      "type": "string"
    },
    "captf_cluster": {
      "type": "any"
    },
    "captf_cluster_outputs": {
      "type": "any"
    },
    "captf_contract": {
      "type": "string"
    },
    "captf_object": {
      "type": "any"
    },
    "captf_tags": {
      "type": "map(string)"
    },
    "control_plane": {
      "type": "bool"
    },
    "db_password": {
      "sensitive": true
    },
    "disk_gib": {},
    "failure_domain": {
      "type": "string",
      "default": null
    },
    "instance_type": {},
    "kubernetes_version": {
      "type": "string",
      "default": null
    },
    "machine_name": {
      "type": "string"
    },
    "ratio": {},
    "subnet_ids": {}
  },
  "module": {
    "role": {
      "bootstrap_data": "${var.bootstrap_data}",
      "bootstrap_format": "${var.bootstrap_format}",
      "captf_cluster": "${var.captf_cluster}",
      "captf_cluster_outputs": "${var.captf_cluster_outputs}",
      "captf_contract": "${var.captf_contract}",
      "captf_object": "${var.captf_object}",
      "captf_tags": "${var.captf_tags}",
      "control_plane": "${var.control_plane}",
      "db_password": "${var.db_password}",
      "disk_gib": "${var.disk_gib}",
      "failure_domain": "${var.failure_domain}",
      "instance_type": "${var.instance_type}",
      "kubernetes_version": "${var.kubernetes_version}",
      "machine_name": "${var.machine_name}",
      "ratio": "${var.ratio}",
      "source": "../../module",
      "subnet_ids": "${var.subnet_ids}"
    }
  },
  "output": {
    "addresses": {
      "value": "${module.role.addresses}",
      "sensitive": true
    },
    "failure_domain": {
      "value": "${module.role.failure_domain}",
      "sensitive": true
    },
    "health": {
      "value": "${module.role.health}",
      "sensitive": true
    },
    "interruptible": {
      "value": "${module.role.interruptible}",
      "sensitive": true
    },
    "provider_id": {
      "value": "${module.role.provider_id}",
      "sensitive": true
    }
  }
}
